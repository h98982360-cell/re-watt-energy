# ---- App ----
APP_NAME=Re-Watt Energy
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
# Comma separated list of allowed CORS origins for the frontend dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database ----
# Production target is PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg://rewatt:rewatt@localhost:5432/rewatt
# For local demos SQLite is used by default (no server required).
DATABASE_URL=sqlite:///./rewatt.db
AUTO_CREATE_SCHEMA=true

# ---- Security ----
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
# Set to false in production so phone/email codes are never returned over the API
EXPOSE_VERIFICATION_CODES=true

# ---- Platform economics ----
# Percentage is configurable and must be validated commercially before launch.
PLATFORM_FEE_PERCENT=5.0
CURRENCY=KES

# ---- Bootstrap admin (not a public signup role) ----
ADMIN_EMAIL=admin@rewatt.energy
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME=Platform Admin

# ---- AI (isolated server side; the frontend never sees these) ----
# Any OpenAI compatible chat completions endpoint works.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# ---- AI service ----
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_API_KEY=pick-any-long-random-string
AI_SERVICE_TIMEOUT_SECONDS=20
